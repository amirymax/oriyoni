# systemd unit for the Django API. Install to /etc/systemd/system/oriyoni.service.
#
# Django reads /srv/oriyoni/.env itself, so no EnvironmentFile is needed here —
# one less place for production config to drift out of sync.
[Unit]
Description=ORIYONI Django API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
# gunicorn tells systemd when it is actually ready to serve, so `systemctl
# restart` blocks until the new workers are up rather than returning instantly
# and leaving a deploy script to guess.
Type=notify
User=deploy
Group=deploy
WorkingDirectory=/srv/oriyoni
ExecStart=/srv/oriyoni/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --threads 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -

# Logs go to the journal; read them with `journalctl -u oriyoni -f`.
Restart=always
RestartSec=5

# The app writes only to media/, so the rest of the filesystem can be read-only
# to it. Cheap insurance against a bug or an exploit touching anything else.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
