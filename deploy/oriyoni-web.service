# systemd unit for the Next.js storefront.
# Install to /etc/systemd/system/oriyoni-web.service.
[Unit]
Description=ORIYONI storefront (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/oriyoni/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
