# Copy to .env and adjust. The defaults below match docker-compose.yml, so a
# fresh checkout works with `docker compose up -d` and no edits.

# ---------------------------------------------------------------- django --
# Generate one for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://oriyoni:oriyoni@localhost:5432/oriyoni

# Consumed by docker-compose.yml when you need non-default local settings.
# POSTGRES_DB=oriyoni
# POSTGRES_USER=oriyoni
# POSTGRES_PASSWORD=oriyoni
# POSTGRES_PORT=5432

# ------------------------------------------------------------------ auth --
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Secure defaults to on whenever DEBUG is off. If the storefront and the API
# sit on different sites in production, SameSite must be None — and browsers
# only accept None together with Secure.
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_SAMESITE=None
# Set to a shared parent domain (".oriyoni.shop") to use SameSite=Lax instead.
# AUTH_COOKIE_DOMAIN=

# Per-IP limits on the endpoints worth brute forcing.
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_EMAIL_VERIFY=20/hour
THROTTLE_EMAIL_VERIFY_RESEND=5/hour

# ------------------------------------------------------- storefront/CORS --
# Where the storefront runs. Password reset links are built from it.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- email --
# The console backend prints reset links into the runserver log; swap for SMTP
# in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production sends through Brevo's SMTP relay. The login is the generated
# address their SMTP tab shows (not your account email), and the password is
# an SMTP key generated there — never the account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ORIYONI <no-reply@oriyoni.shop>

# Seconds a password reset link stays valid. Default is 3 hours.
PASSWORD_RESET_TIMEOUT=10800
# How long a signup confirmation link stays valid, in seconds (48 hours).
EMAIL_VERIFICATION_TIMEOUT=172800

# ------------------------------------------------------------ production --
# Everything below only takes effect when DJANGO_DEBUG=False.
#
# HSTS starts at one hour. Raise it once you are certain every subdomain is on
# HTTPS — browsers remember it, so a careless value is hard to walk back.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Only turn off if something in front of Django already redirects to HTTPS.
# SECURE_SSL_REDIRECT=True

# Where the contact form is delivered.
CONTACT_EMAIL=hello@oriyoni.shop

# LOG_LEVEL=INFO
