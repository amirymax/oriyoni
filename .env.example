# Copy to .env and adjust. The defaults below match docker-compose.yml, so a
# fresh checkout works with `docker compose up -d` and no edits.

# Generate one for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://oriyoni:oriyoni@localhost:5432/oriyoni

# Consumed by docker-compose.yml when you need non-default local settings.
# POSTGRES_DB=oriyoni
# POSTGRES_USER=oriyoni
# POSTGRES_PASSWORD=oriyoni
# POSTGRES_PORT=5432
