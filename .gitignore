# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------- frontend --
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage
frontend/.next/
frontend/out/
frontend/build
frontend/next-env.d.ts
*.tsbuildinfo

# ----------------------------------------------------------------- backend --
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
staticfiles/
mediafiles/

# --------------------------------------------------------------------- env --
# Committed sample stays; real secrets never do.
.env*
!.env.example

# -------------------------------------------------------------------- misc --
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
